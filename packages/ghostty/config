# Font
font-family = Monaco
font-size = 15

# Window
window-width = 80
window-height = 25

# Appearance
background = #000000
foreground = #bbbbbb
background-opacity = 0.64

# Cursor
cursor-style = block
cursor-style-blink = false
cursor-color = #bbbbbb

# Scrollback
scrollback-limit = 100000

# ANSI Colors (converted from iTerm2 RGB values)
palette = 0=#000000
palette = 1=#bb0000
palette = 2=#00bb00
palette = 3=#bbbb00
palette = 4=#0000bb
palette = 5=#bb00bb
palette = 6=#00bbbb
palette = 7=#bbbbbb
palette = 8=#555555
palette = 9=#ff5555
palette = 10=#55ff55
palette = 11=#ffff55
palette = 12=#5555ff
palette = 13=#ff55ff
palette = 14=#55ffff
palette = 15=#ffffff

# Global hotkey (Command+` to toggle window)
keybind = global:cmd+escape=toggle_visibility

# macOS settings
window-theme = dark
window-colorspace = srgb
mouse-reporting = true
clipboard-read = ask
clipboard-write = ask
window-decoration = auto
